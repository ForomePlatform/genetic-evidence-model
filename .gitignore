# UMLS crosswalk harness: transient / synthetic / cached artifacts.
# The inputs (dimensions_inventory.yaml, omop_cdm_examples.yaml), the code,
# the tests + fixtures, and the populated umls_crosswalk.yaml are tracked;
# the cache and the synthetic-CUI demo/preview files are not.
data/umls/cache/
data/umls/*.demo.yaml
data/umls/*.preview.tex

# Archived handover / obsolete working notes
internal/

# UMLS-derived sweep results (concept names incl. SNOMED strings): not
# redistributed; regenerate with gem-umls-sweep + gem-umls-classify-credibility.
data/umls/sweeps/*.results.*
